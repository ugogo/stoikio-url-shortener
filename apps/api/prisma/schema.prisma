datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API is a CommonJS NestJS app; the generator is ESM-first by default.
  moduleFormat = "cjs"
}

model ShortLink {
  slug        String   @id
  destination String
  createdAt   DateTime @default(now())
}
